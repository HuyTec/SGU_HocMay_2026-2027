{
  "weights": {"xgboost": 0.8, "lasso": 0.2},
  "target_transform": "natural log",
  "outlier_rule": {"GrLivArea_gt": 4000, "SalePrice_lt": 200000},
  "feature_formulas": {
    "TotalSF": "TotalBsmtSF + 1stFlrSF + 2ndFlrSF",
    "TotalBath": "FullBath + BsmtFullBath + 0.5 * (HalfBath + BsmtHalfBath)",
    "AgeAtSale": "YrSold - YearBuilt"
  },
  "xgboost": {
    "extra_features": ["TotalSF", "TotalBath"],
    "params": {"n_estimators": 200, "max_depth": 4, "learning_rate": 0.05, "random_state": 42, "n_jobs": 2}
  },
  "lasso": {
    "extra_features": ["TotalSF", "TotalBath", "AgeAtSale"],
    "params": {"alpha": 0.001, "max_iter": 10000}
  }
}

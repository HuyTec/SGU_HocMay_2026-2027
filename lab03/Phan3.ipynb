    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "f = pd.read_csv(\"data/train.csv\")\n",
    "df[\"TotalSF\"] = df[\"TotalBsmtSF\"].fillna(0) + df[\"1stFlrSF\"] + df[\"2ndFlrSF\"]\n",
    "\n",
    "\n",
    "# ---------- 2. VIF ----------\n",
    "def calc_vif(data):\n",
    "    \"\"\"VIF_i = 1 / (1 - R^2_i), với R^2_i là hồi quy biến i theo các biến còn lại.\"\"\"\n",
    "    X = data.dropna().astype(float)\n",
    "    X = (X - X.mean()) / X.std()\n",
    "    out = {}\n",
    "    for c in X.columns:\n",
    "        y = X[c].values\n",
    "        A = np.column_stack([np.ones(len(X)), X.drop(columns=c).values])\n",
    "        beta, *_ = np.linalg.lstsq(A, y, rcond=None)\n",
    "        r2 = 1 - ((y - A @ beta) ** 2).sum() / ((y - y.mean()) ** 2).sum()\n",
    "        out[c] = np.inf if r2 >= 1 - 1e-10 else 1 / (1 - r2)\n",
    "    return pd.Series(out, name=\"VIF\").sort_values(ascending=False)\n",
    "\n",
    "# chưa xử lý\n",
    "cols_before = [\"OverallQual\", \"GrLivArea\", \"TotalBsmtSF\", \"1stFlrSF\", \"GarageCars\",\n",
    "               \"GarageArea\", \"TotRmsAbvGrd\", \"FullBath\", \"YearBuilt\", \"YearRemodAdd\",]\n",
    "vif_before = calc_vif(df[cols_before])\n",
    "print(\"\\n=== VIF trước khi xử lý ===\")\n",
    "print(vif_before.round(2))\n",
    "# ---------- 3. VẼ BIỂU ĐỒ VIF ----------\n",
    "def plot_vif(vif, title, fname):\n",
    "    v = vif.sort_values()  # VIF nhỏ ở dưới, lớn ở trên\n",
    "    colors = [\"#AE0B0B\" if x > 5 else \"#7E8C96\" for x in v.values]  # đỏ nếu VIF > 5\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(7, 5))\n",
    "    ax.barh(v.index, v.values, color=colors)\n",
    "    ax.axvline(5, color=\"red\", linestyle=\"--\", linewidth=1, label=\"Ngưỡng VIF = 5\")\n",
    "\n",
    "    # ghi giá trị VIF cạnh mỗi cột\n",
    "    for i, x in enumerate(v.values):\n",
    "        ax.text(x + 0.05, i, f\"{x:.2f}\", va=\"center\", fontsize=9)\n",
    "\n",
    "    ax.set_xlabel(\"VIF\")\n",
    "    ax.set_title(title)\n",
    "    ax.legend()\n",

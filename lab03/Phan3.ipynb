    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "df = pd.read_csv(\"data/train.csv\")\n",
    "df[\"TotalSF\"] = df[\"TotalBsmtSF\"].fillna(0) + df[\"1stFlrSF\"] + df[\"2ndFlrSF\"]\n",
    "\n",
    "# ---------- 1. CÁC CẶP BIẾN TƯƠNG QUAN CAO (|r| > 0.7) ----------\n",
    "num = df.select_dtypes(\"number\").drop(columns=[\"Id\", \"SalePrice\"])\n",
    "corr = num.corr()\n",
    "pairs = corr.where(np.triu(np.ones(corr.shape), 1).astype(bool)).stack()\n",
    "pairs = pairs[pairs.abs() > 0.7].sort_values(key=abs, ascending=False)\n",
    "pairs = pairs.rename(\"r\").reset_index()\n",
    "pairs.columns = [\"Biến 1\", \"Biến 2\", \"r\"]\n",
    "print(\"=== Cặp biến có |r| > 0.7 ===\")\n",
    "print(pairs.round(3).to_string(index=False))\n",
    "pairs.to_csv(\"high_corr_pairs.csv\", index=False)\n",
    "\n",
    "# ---------- 2. VIF ----------\n",
    "def calc_vif(data):\n",
    "    \"\"\"VIF_i = 1 / (1 - R^2_i), với R^2_i là hồi quy biến i theo các biến còn lại.\"\"\"\n",
    "    X = data.dropna().astype(float)\n",
    "    X = (X - X.mean()) / X.std()\n",
    "    out = {}\n",
    "    for c in X.columns:\n",
    "        y = X[c].values\n",
    "        A = np.column_stack([np.ones(len(X)), X.drop(columns=c).values])\n",
    "        beta, *_ = np.linalg.lstsq(A, y, rcond=None)\n",
    "        r2 = 1 - ((y - A @ beta) ** 2).sum() / ((y - y.mean()) ** 2).sum()\n",
    "        out[c] = np.inf if r2 >= 1 - 1e-10 else 1 / (1 - r2)\n",
    "    return pd.Series(out, name=\"VIF\").sort_values(ascending=False)\n",
    "\n",
    "# 2a. Bộ biến gốc (chưa xử lý)\n",
    "cols_before = [\"OverallQual\", \"GrLivArea\", \"TotalBsmtSF\", \"1stFlrSF\", \"GarageCars\",\n",
    "               \"GarageArea\", \"TotRmsAbvGrd\", \"FullBath\", \"YearBuilt\", \"YearRemodAdd\"]\n",
    "vif_before = calc_vif(df[cols_before])\n",
    "print(\"\\n=== VIF trước khi xử lý ===\")\n",
    "print(vif_before.round(2))\n",
    "\n",
    "# 2b. Sau khi bỏ GarageArea (giữ GarageCars) và TotRmsAbvGrd (giữ GrLivArea)\n",
    "cols_after = [c for c in cols_before if c not in [\"GarageArea\", \"TotRmsAbvGrd\"]]\n",
    "vif_after = calc_vif(df[cols_after])\n",
    "print(\"\\n=== VIF sau khi xử lý ===\")\n",
    "print(vif_after.round(2))\n",
    "\n",
    "# ---------- 3. VẼ BIỂU ĐỒ SO SÁNH ----------\n",
    "fig, axes = plt.subplots(1, 2, figsize=(13, 5), sharex=True)\n",
    "for ax, v, t in zip(axes, [vif_before, vif_after],\n",
    "                    [\"Trước khi xử lý\", \"Sau khi bỏ GarageArea & TotRmsAbvGrd\"]):\n",
    "    v = v.sort_values()\n",
    "    colors = [\"#E4572E\" if x > 5 else \"#76B1D8\" for x in v.values]\n",
    "    ax.barh(v.index, v.values, color=colors)\n",
    "    ax.axvline(5, color=\"red\", linestyle=\"--\", linewidth=1, label=\"Ngưỡng VIF = 5\")\n",
    "    ax.set_title(t)\n",
    "    ax.set_xlabel(\"VIF\")\n",
    "    for i, x in enumerate(v.values):\n",
    "        ax.text(x + 0.05, i, f\"{x:.2f}\", va=\"center\", fontsize=8)\n",
    "axes[0].legend()\n",
    "plt.suptitle(\"Chỉ số VIF - phát hiện đa cộng tuyến\")\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"vif_comparison.png\", dpi=140)\n",
    "plt.show()"
   ]
  },

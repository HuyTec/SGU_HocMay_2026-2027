  <diagram id="trang-2-eda-tien-xu-ly" name="2. Chi tiết: EDA → Tiền xử lý chung">
    <mxGraphModel dx="2952" dy="1638" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2100" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Times New Roman;fontSize=16;align=left;" value="&lt;b&gt;CHI TIẾT 1 — EDA CHUNG VÀ TIỀN XỬ LÝ DỮ LIỆU CHUNG (mở từ khối “Tiền xử lý dữ liệu chung”, trang 1)&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="1250" x="40" y="15" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;spacing=4;fontFamily=Times New Roman;fontSize=11;" value="&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;font-size:11px;width:100%;font-family:Times New Roman&quot;&gt;&lt;tr style=&quot;background:#f5f5f5&quot;&gt;&lt;th align=&quot;left&quot; width=&quot;28%&quot;&gt;Ký hiệu&lt;/th&gt;&lt;th align=&quot;left&quot; width=&quot;40%&quot;&gt;Ý nghĩa&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Ví dụ&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Hình bình hành&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Tập dữ liệu&lt;/td&gt;&lt;td&gt;CSV gốc&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Hình chữ nhật&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Hoạt động thực hiện&lt;/td&gt;&lt;td&gt;Khảo sát EDA&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Hình elip đứt nét (xanh ngọc / cam)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Một phát hiện (xanh ngọc) hoặc một quyết định xử lý (cam)&lt;/td&gt;&lt;td&gt;“Có nhiệt độ 0 K” / “Đánh dấu 0 K là thiếu”&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Hình chữ nhật viền đôi&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Quy trình con cần mở ra xem chi tiết&lt;/td&gt;&lt;td&gt;Tiền xử lý dữ liệu&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Hình thoi &lt;i&gt;(bổ sung)&lt;/i&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Điều kiện rẽ nhánh Có / Không trong quy trình con&lt;/td&gt;&lt;td&gt;“Nhiệt độ thiếu?”&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Khung chấm &lt;i&gt;(bổ sung)&lt;/i&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Nhóm các tập dữ liệu cùng chịu một ràng buộc&lt;/td&gt;&lt;td&gt;Train / Validation / Test&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Mũi tên liền&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Dữ liệu hoặc trình tự hoạt động&lt;/td&gt;&lt;td&gt;CSV → tiền xử lý&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Mũi tên nét đứt&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Quan hệ giải thích hoặc áp dụng quy tắc&lt;/td&gt;&lt;td&gt;Phát hiện → quyết định → quy trình con&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="235" width="640" x="1330" y="15" as="geometry" />
        </mxCell>
        <mxCell id="csv" parent="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;shapeInside=1;fixedSize=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=12;" value="CSV dữ liệu giao thông (dữ liệu thô)" vertex="1">

        </mxCell>
        <mxCell id="eda" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Times New Roman;fontSize=12;" value="Kiểm tra và khảo sát dữ liệu (EDA) chung" vertex="1">

  <diagram id="trang-5-evaluate" name="5. Đánh giá mô hình">
    <mxGraphModel dx="1189" dy="660" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="2000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=20;fontStyle=1;" value="CHI TIẾT 4 — ĐÁNH GIÁ, SO SÁNH VÀ CHỐT MÔ HÌNH" vertex="1">
          <mxGeometry height="45" width="1450" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="input" parent="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;align=center;verticalAlign=middle;spacing=8;" value="Mô hình đã fit trên Train + quy tắc xử lý đã học&lt;br&gt;Đầu vào: Validation theo thời gian" vertex="1">
          <mxGeometry height="75" width="570" x="465" y="100" as="geometry" />
        </mxCell>
        <mxCell id="pred" parent="1" style="shape=process;backgroundOutline=1;fillColor=#fad9d5;strokeColor=#ae4132;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;align=center;verticalAlign=middle;spacing=8;" value="Dự đoán Validation&lt;br&gt;Áp dụng đúng quy tắc đã học; không fit lại bằng Validation" vertex="1">
          <mxGeometry height="80" width="570" x="465" y="230" as="geometry" />
        </mxCell>
        <mxCell id="metrics" parent="1" style="rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;align=center;verticalAlign=middle;spacing=8;" value="Tính MAE, RMSE, R² và số giờ đánh giá&lt;br&gt;Ghi rõ cách xử lý dự đoán âm nếu áp dụng" vertex="1">
          <mxGeometry height="80" width="570" x="465" y="365" as="geometry" />
        </mxCell>
        <mxCell id="same" parent="1" style="shape=process;backgroundOutline=1;fillColor=#fad9d5;strokeColor=#ae4132;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;align=center;verticalAlign=middle;spacing=8;" value="&lt;b&gt;So sánh công bằng&lt;/b&gt;&lt;br&gt;Cùng mốc chia, cùng giờ đánh giá; ghi tập train, số mẫu và tỷ lệ bao phủ.&lt;br&gt;Khi so B–C, đối chiếu thêm trên các giờ đủ lịch sử." vertex="1">
          <mxGeometry height="110" width="720" x="390" y="505" as="geometry" />
        </mxCell>
        <mxCell id="slices" parent="1" style="rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;align=center;verticalAlign=middle;spacing=8;" value="Phân tích sai số theo giờ, ngày thường / lễ và thời tiết&lt;br&gt;Ghi số mẫu mỗi nhóm; so với baseline trên cùng giờ" vertex="1">
          <mxGeometry height="85" width="570" x="465" y="670" as="geometry" />
        </mxCell>
        <mxCell id="choose" parent="1" style="shape=process;backgroundOutline=1;fillColor=#fad9d5;strokeColor=#ae4132;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;align=center;verticalAlign=middle;spacing=8;" value="Dựa trên CV + Validation: chọn mô hình và cấu hình&lt;br&gt;Chốt nguồn dữ liệu, đặc trưng, tiền xử lý, tham số và kịch bản dự đoán" vertex="1">
          <mxGeometry height="100" width="720" x="390" y="810" as="geometry" />
        </mxCell>
        <mxCell id="refit" parent="1" style="shape=process;backgroundOutline=1;fillColor=#fad9d5;strokeColor=#ae4132;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;align=center;verticalAlign=middle;spacing=8;" value="Chốt trước: fit cuối trên Train hoặc Train + Validation&lt;br&gt;Nếu fit lại: học lại tiền xử lý chỉ trên tập fit cuối" vertex="1">
          <mxGeometry height="85" width="570" x="465" y="970" as="geometry" />
        </mxCell>
        <mxCell id="test" parent="1" style="rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;align=center;verticalAlign=middle;spacing=8;" value="Dùng quy trình đã chốt dự đoán Test&lt;br&gt;Tính MAE, RMSE, R²; ghi số mẫu và phạm vi áp dụng" vertex="1">
          <mxGeometry height="85" width="570" x="465" y="1115" as="geometry" />
        </mxCell>
        <mxCell id="report" parent="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;align=center;verticalAlign=middle;spacing=8;" value="Báo cáo kết quả cuối: cấu hình, mốc chia, metrics, baseline,&lt;br&gt;phân tích lỗi, giới hạn dữ liệu và điều kiện vận hành" vertex="1">
          <mxGeometry height="80" width="640" x="430" y="1260" as="geometry" />
        </mxCell>
        <mxCell id="guard" parent="1" style="shape=note;backgroundOutline=1;darkOpacity=0.05;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;spacing=8;fontFamily=Times New Roman;fontSize=13;" value="&lt;b&gt;Giữ Test độc lập&lt;/b&gt;&lt;br&gt;Không dùng Test để chọn mô hình, tham số, đặc trưng hay quy tắc dữ liệu. Nếu thay đổi sau khi xem Test, báo cáo rõ và cần dữ liệu kiểm tra độc lập mới." vertex="1">
          <mxGeometry height="190" width="350" x="1120" y="955" as="geometry" />
        </mxCell>
        <mxCell id="scenario" parent="1" style="shape=note;backgroundOutline=1;darkOpacity=0.05;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;spacing=8;fontFamily=Times New Roman;fontSize=13;" value="&lt;b&gt;Đầu vào có sẵn lúc dự đoán&lt;/b&gt;&lt;br&gt;Thời tiết cùng giờ: chỉ dùng nếu đã có hoặc là dự báo sẵn có. History: chỉ dùng quan sát trước t; nếu dùng các giờ trước trong Validation / Test thì đây là dự đoán tuần tự." vertex="1">
          <mxGeometry height="230" width="315" x="40" y="505" as="geometry" />
        </mxCell>
        <mxCell id="baseline" parent="1" style="shape=note;backgroundOutline=1;darkOpacity=0.05;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;spacing=8;fontFamily=Times New Roman;fontSize=13;" value="Baseline: trung bình thứ–giờ; seasonal naive t − 7 ngày khi lịch sử thực sự sẵn có. So sánh trên cùng giờ với mô hình." vertex="1">
          <mxGeometry height="145" width="315" x="40" y="780" as="geometry" />
        </mxCell>
